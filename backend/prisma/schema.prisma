// DocFinder database schema
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env
// npx prisma migrate dev --name center_doctor_pivot
// npx prisma generate
// restart the TS server: Ctrl+Shift+P → "TypeScript: Restart TS Server" → Enter.
// npx prisma studio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  CENTER
  ADMIN
}

enum BookingStatus {
  BOOKED
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  phone         String?
  role          Role
  createdAt     DateTime       @default(now())

  centerProfile CenterProfile?
  bookings      Booking[]      @relation("PatientBookings")
  reviews       Review[]
  notifications Notification[]
}

model CenterProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])

  city          String?
  clinicAddress String?
  bio           String?
  photoUrl      String?

  doctors       Doctor[]
}

model Doctor {
  id           String         @id @default(uuid())
  centerId     String
  center       CenterProfile  @relation(fields: [centerId], references: [id])

  name         String
  specialty    String
  phone        String
  fee          Int
  bio          String?
  email        String?

  availability Availability[]
  bookings     Booking[]
  reviews      Review[]
}

model Availability {
  id         String      @id @default(uuid())
  doctorId   String
  doctor     Doctor      @relation(fields: [doctorId], references: [id])

  dayOfWeek  Int         // 0 = Sunday ... 6 = Saturday
  startTime  String      // "10:00"
  endTime    String      // "11:00"

  slotBlocks SlotBlock[]
}

// Presence of a row = that specific date is marked "Full" for this weekly slot
model SlotBlock {
  id             String       @id @default(uuid())
  availabilityId String
  availability   Availability @relation(fields: [availabilityId], references: [id])
  date           DateTime

  @@unique([availabilityId, date])
}

model Booking {
  id           String        @id @default(uuid())
  patientId    String
  patient      User          @relation("PatientBookings", fields: [patientId], references: [id])

  doctorId     String
  doctor       Doctor        @relation(fields: [doctorId], references: [id])

  date         DateTime
  timeSlot     String
  patientName  String
  patientPhone String
  status       BookingStatus @default(BOOKED)
  paid         Boolean       @default(false)
  createdAt    DateTime      @default(now())
}

model Review {
  id        String   @id @default(uuid())
  patientId String
  patient   User     @relation(fields: [patientId], references: [id])

  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])

  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  type      String
  message   String
  bookingId String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
