# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL connection string (Neon / Supabase / Railway / local)
DATABASE_URL="postgresql://user:password@host:5432/docfinder?schema=public"

# Random long string, used to sign JWTs
JWT_SECRET="replace-with-a-long-random-string"

# Port the Express server runs on
PORT=5000

# (Add later, Phase 5)
STRIPE_SECRET_KEY=""
